{
  "name": "partline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test tests/*.test.js",
    "test:ui": "vitest run",
    "format": "prettier --write src server tests *.js package.json README.md",
    "format:check": "prettier --check src server tests *.js package.json README.md",
    "build:pages": "vite build --mode pages"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
